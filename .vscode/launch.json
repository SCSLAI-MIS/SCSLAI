{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:5500/FRONT/index.html",
            "webRoot": "${workspaceFolder}/FRONT",
            "sourceMaps": false,
            "resolveSourceMapLocations": [
                "**",
                "!**/node_modules/**",
                "!**/npm/**"
            ],
            "skipFiles": [
                "**/npm/**",
                "**/cdn.jsdelivr.net/**"
            ]
        }
    ]
}
